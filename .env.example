# A/D CTF Command Center — Environment Configuration
# Copy this file to .env and fill in your values

# Team identity
TEAM_ID=2
TEAM_TOKEN=your_team_token_here
SSH_PASSWORD=your_ssh_password_here

# Game settings
GAME_TICK_SECONDS=120
TOTAL_TEAMS=30

# CORS (comma-separated origins for dev)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
